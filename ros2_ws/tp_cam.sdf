<?xml version="1.0"?>
<sdf version="1.8">
  <model name="tp_cam">
    <static>true</static>
    <!-- South of the flight path, elevated, looking north across home(0,0)->marker(11,10) -->
    <pose>5.5 -8 8 0 0.37 1.5708</pose>
    <link name="link">
      <sensor name="tp_camera" type="camera">
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>300</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <topic>third_person/image</topic>
      </sensor>
    </link>
  </model>
</sdf>
