<?xml version="1.0"?>
<package format="3">
  <name>drop_policy</name>
  <version>0.1.0</version>
  <description>Deployment of the Isaac Lab drop policy (L0 flight + GRU impact residual) on PX4 via ROS 2.</description>
  <maintainer email="team@dronebombard.com">drone-bombard</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>drone_controller</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
