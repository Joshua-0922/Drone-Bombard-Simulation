<?xml version="1.0"?>
<!--
  x_marker/model.sdf - Gazebo Harmonic compatible
  =================================================
  Visual: white background square + two red diagonal bars forming an X shape.
  The X is 1.5 m × 1.5 m, visible from the drone at 10 m altitude.
  Bar width 0.2 m, rotated ±45° around Z to form the cross.
  Collision kept as a single flat box for simplicity.
-->
<sdf version="1.9">
  <model name="x_marker">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.001 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.002</size>
          </box>
        </geometry>
      </collision>

      <!-- White background square -->
      <visual name="background">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.5 1.5 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1</ambient>
          <diffuse>1.0 1.0 1.0 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <!-- Red diagonal bar 1: bottom-left → top-right (+45°) -->
      <visual name="bar1">
        <pose>0 0 0.001 0 0 0.7854</pose>
        <geometry>
          <box>
            <size>0.2 1.3 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.3 0.0 0.0 1</specular>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.7</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Red diagonal bar 2: top-left → bottom-right (-45°) -->
      <visual name="bar2">
        <pose>0 0 0.001 0 0 -0.7854</pose>
        <geometry>
          <box>
            <size>0.2 1.3 0.002</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1</ambient>
          <diffuse>1.0 0.0 0.0 1</diffuse>
          <specular>0.3 0.0 0.0 1</specular>
          <pbr>
            <metal>
              <metalness>0.0</metalness>
              <roughness>0.7</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
