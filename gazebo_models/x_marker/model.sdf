<?xml version="1.0"?>
<!--
  x_marker/model.sdf - Gazebo Harmonic compatible
  =================================================
  Updated from SDF 1.5 to SDF 1.9.
  Material: OGRE1 <script> format replaced with Harmonic PBR <material>.
  The X texture (XMarker/Texture) is represented as a high-contrast
  yellow box visible from above. To restore the original X texture,
  provide OGRE2-compatible .material files in materials/scripts/.
  No plugins in this model (static visual marker only).
-->
<sdf version="1.9">
  <model name="x_marker">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.001 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>1.0 1.0 0.001</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>1.0 1.0 0.001</size>
          </box>
        </geometry>
        <!-- Harmonic PBR material (replaces OGRE1 <script> block).
             Bright yellow to be visually distinct from ground.
             TODO: replace with OGRE2 .material + texture for X pattern. -->
        <material>
          <ambient>1.0 0.9 0.0 1</ambient>
          <diffuse>1.0 0.9 0.0 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
