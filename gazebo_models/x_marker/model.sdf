<?xml version="1.0"?>
<!--
  x_marker/model.sdf - Gazebo Harmonic compatible
  =================================================
  Visual: single flat plane with x_marker.png PBR albedo texture (ogre2).
  The X is 1.5 m × 1.5 m, visible from the drone at 10 m altitude.
  Single mesh avoids z-fighting; PBR albedo_map is the ogre2-correct way
  to apply textures. Collision kept as a single flat box for simplicity.
-->
<sdf version="1.9">
  <model name="x_marker">
    <static>true</static>
    <link name="link">
      <pose>0 0 0.001 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>1.5 1.5 0.002</size>
          </box>
        </geometry>
      </collision>

      <!-- Single PBR-textured plane using x_marker.png (ogre2 compatible) -->
      <visual name="marker">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>1.5 1.5 0.001</size>
          </box>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://x_marker/materials/textures/x_marker.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>0.8</roughness>
            </metal>
          </pbr>
        </material>
      </visual>

    </link>
  </model>
</sdf>
