<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500_bombard - Gazebo Harmonic quadrotor model
  ================================================
  Extends PX4's x500 model with:
    - Magnetometer sensor (gz::sim::systems::Magnetometer)
    - Downward-facing RGB camera (640x480, 30 Hz)
        gz-transport topic: /x500_bombard/down_camera/image_raw
        ROS2 topic (via ros_gz_bridge): /camera/rgb/image_raw
    - Payload cylinder integrated at drone belly
        DetachableJoint attaches the separately-spawned payload_cylinder model.
        Drop trigger: publish gz.msgs.Empty to /x500_bombard/drop
        ROS2 trigger (via ros_gz_bridge): publish std_msgs/Empty to /payload/drop_cmd

  Plugin migration from Classic to Harmonic:
    libgazebo_motor_model.so       -> gz::sim::systems::MulticopterMotorModel  (inherited from x500)
    libgazebo_imu_plugin.so        -> gz::sim::systems::Imu                    (inherited via x500_base)
    libgazebo_barometer_plugin.so  -> gz::sim::systems::AirPressure             (inherited via x500_base)
    libgazebo_magnetometer_plugin  -> gz::sim::systems::Magnetometer            (added below)
    libgazebo_groundtruth_plugin   -> removed; PX4 uses gz-transport internally
    libgazebo_mavlink_interface    -> removed; replaced by uXRCE-DDS + gz-transport
    libgazebo_ros_camera.so        -> gz::sim::systems::Sensors (world-level) + ros_gz_bridge
    libgazebo_ros_link_attacher    -> gz::sim::systems::DetachableJoint (model-level)
-->
<sdf version="1.9">
  <model name="x500_bombard">

    <!-- ============================================================
         Inherit x500 base: 4 rotors + MulticopterMotorModel plugins,
         IMU, AirPressure, NavSat sensors, structural links & joints.
    ============================================================ -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- ============================================================
         Magnetometer sensor
         Classic: libgazebo_magnetometer_plugin.so
         Harmonic: gz::sim::systems::Magnetometer world plugin +
                   <sensor type="magnetometer"> in this link
    ============================================================ -->
    <link name="magnetometer_link">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
        </inertia>
      </inertial>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.0004</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.0004</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0004</stddev></noise></z>
        </magnetometer>
      </sensor>
    </link>
    <joint name="magnetometer_joint" type="fixed">
      <parent>base_link</parent>
      <child>magnetometer_link</child>
    </joint>

    <!-- ============================================================
         Downward-facing RGB Camera
         Classic: libgazebo_ros_camera.so (inside <sensor>)
         Harmonic: world-level gz::sim::systems::Sensors handles rendering;
                   image bridged to ROS2 via ros_gz_bridge.

         Pitch -90 deg (1.5708 rad) so sensor Z-axis points downward.
         gz-transport topic : /x500_bombard/down_camera/image_raw
         ROS2 topic          : /camera/rgb/image_raw  (via bridge)
    ============================================================ -->
    <link name="down_camera_link">
      <pose relative_to="base_link">0.1 0 -0.04 0 1.5707963268 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="cam_visual">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="down_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/x500_bombard/down_camera/image_raw</topic>
        <camera name="down_camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip><near>0.1</near><far>100</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="down_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>down_camera_link</child>
    </joint>

    <!-- ============================================================
         Payload mount point — drone belly
         A fixed structural link centred below base_link (z = -0.10 m).
         The payload_cylinder model (spawned in the world) is attached
         here at simulation start by the DetachableJoint plugin below.

         Payload world spawn pose must match this link's world position:
           drone base_link world-z ≈ 0.24 m (from x500_base model pose)
           mount world-z = 0.24 - 0.10 = 0.14 m
         → spawn payload_cylinder at z = 0.14 in x_marker_harmonic.sdf
    ============================================================ -->
    <link name="payload_mount">
      <pose relative_to="base_link">0 0 -0.10 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
        </inertia>
      </inertial>
      <!-- Small visual indicator of payload attachment point -->
      <visual name="mount_visual">
        <geometry><cylinder><radius>0.015</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.8 0.4 0.0 1</ambient><diffuse>0.8 0.4 0.0 1</diffuse></material>
      </visual>
    </link>
    <joint name="payload_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>payload_mount</child>
    </joint>

    <!-- ============================================================
         DetachableJoint — payload drop mechanism
         Classic: libgazebo_ros_link_attacher /attach + /detach services
         Harmonic: gz::sim::systems::DetachableJoint topic-based detach

         At startup  : creates a fixed joint between payload_mount (drone)
                       and payload_link (payload_cylinder world model).
         On drop cmd : publish gz.msgs.Empty to /x500_bombard/drop
                       → joint is destroyed → payload falls freely.

         ROS2 integration via ros_gz_bridge
           ros_topic: /payload/drop_cmd  (std_msgs/msg/Empty, ROS_TO_GZ)
           gz_topic : /x500_bombard/drop (gz.msgs.Empty)
         See: config/ros_gz_bridge.yaml
    ============================================================ -->
    <plugin name="gz::sim::systems::DetachableJoint"
            filename="gz-sim-detachable-joint-system">
      <parent_link>payload_mount</parent_link>
      <child_model>payload_cylinder</child_model>
      <child_link>payload_link</child_link>
      <topic>/x500_bombard/drop</topic>
    </plugin>

  </model>
</sdf>
