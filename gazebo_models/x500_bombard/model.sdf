<?xml version="1.0" encoding="UTF-8"?>
<!--
  x500_bombard - Gazebo Harmonic quadrotor model
  ================================================
  Extends PX4's x500 model with:
    - Downward-facing RGB camera (640x480, 30 Hz)
      gz-transport topic: /x500_bombard/down_camera/image_raw
      ROS2 topic (via ros_gz_bridge): /camera/rgb/image_raw
    - Detachable payload cylinder spawned separately in world;
      attach/detach handled by gazebo_ros_link_attacher Harmonic port.

  Plugin migration from Classic to Harmonic:
    libgazebo_motor_model.so       -> gz::sim::systems::MulticopterMotorModel  (inherited from x500)
    libgazebo_imu_plugin.so        -> gz::sim::systems::Imu                    (inherited via x500_base)
    libgazebo_barometer_plugin.so  -> gz::sim::systems::AirPressure             (inherited via x500_base)
    libgazebo_magnetometer_plugin  -> gz::sim::systems::Magnetometer            (added explicitly below)
    libgazebo_groundtruth_plugin   -> removed; PX4 uses gz-transport internally
    libgazebo_mavlink_interface    -> removed; replaced by uXRCE-DDS + gz-transport
    libgazebo_ros_camera.so        -> gz::sim::systems::Sensors (world-level) + ros_gz_bridge
-->
<sdf version="1.9">
  <model name="x500_bombard">

    <!-- ============================================================
         Inherit x500 base frame: 4 rotors with MulticopterMotorModel
         plugins, IMU sensor, AirPressure sensor, NavSat sensor,
         all structural links and joints.
    ============================================================ -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- ============================================================
         Magnetometer sensor
         Classic: libgazebo_magnetometer_plugin.so
         Harmonic: gz::sim::systems::Magnetometer world plugin +
                   <sensor type="magnetometer"> on base_link
    ============================================================ -->
    <link name="magnetometer_link">
      <pose relative_to="base_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
        </inertia>
      </inertial>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0004</stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0004</stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.0004</stddev>
            </noise>
          </z>
        </magnetometer>
      </sensor>
    </link>
    <joint name="magnetometer_joint" type="fixed">
      <parent>base_link</parent>
      <child>magnetometer_link</child>
    </joint>

    <!-- ============================================================
         Downward-facing RGB Camera
         Classic: libgazebo_ros_camera.so inside <sensor>
         Harmonic: no plugin in sensor; world-level Sensors system handles
                   rendering; ros_gz_bridge publishes to ROS2.

         Orientation: pitch -90 deg (1.5708 rad) to face downward.
         Topic (gz-transport): /x500_bombard/down_camera/image_raw
         Bridged to ROS2: /camera/rgb/image_raw
    ============================================================ -->
    <link name="down_camera_link">
      <pose relative_to="base_link">0.1 0 -0.04 0 1.5707963268 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz><izz>1e-6</izz>
        </inertia>
      </inertial>
      <visual name="cam_visual">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="down_camera" type="camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <topic>/x500_bombard/down_camera/image_raw</topic>
        <camera name="down_camera">
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>
    <joint name="down_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>down_camera_link</child>
    </joint>

  </model>
</sdf>
