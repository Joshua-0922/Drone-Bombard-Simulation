<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
    <model name='x500_bombard'>
    
    <include merge='true'>
      <uri>model://x500</uri>
    </include>

    <link name='down_camera_link'>
      <pose>0 0 -0.05 0 1.570796 0</pose>
      
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-6</iyy><iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      
      <visual name='cam_visual'>
        <geometry>
          <box><size>0.02 0.02 0.02</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>

      <sensor name='down_camera_sensor' type='camera'>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>1</visualize>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        </sensor>
    </link>

    <joint name='camera_joint' type='fixed'>
      <parent>base_link</parent>
      <child>down_camera_link</child>
    </joint>

  </model>
</sdf>