<?xml version="1.0"?>
<model>
  <name>x500_bombard</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Drone Bombard Team</name>
    <email>team@dronebombard.com</email>
  </author>
  <description>
    Custom quadrotor based on PX4 x500 for Gazebo Harmonic.
    Extends x500 with a downward-facing RGB camera (640x480, 30 Hz)
    for X-marker YOLO detection. Camera image bridged to ROS2 via
    ros_gz_bridge on /camera/rgb/image_raw. Compatible with PX4 SITL
    gz target (make px4_sitl gz_x500_bombard or via PX4_GZ_MODEL env var).
    Payload drop controlled via gz-sim-detachable-joint-system topic signal.
  </description>
</model>
