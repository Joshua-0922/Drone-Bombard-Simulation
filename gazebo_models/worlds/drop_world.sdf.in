<?xml version="1.0" encoding="UTF-8"?>
<!--
  drop_world.sdf.in - template for the drop-policy sim-to-sim tests (drop_policy/scripts/run_gazebo_eval.py
  fills @...@). No camera rendering (no Sensors system) -> runs headless without a GPU renderer.
  Drone and payload are pre-spawned; PX4 attaches via PX4_GZ_MODEL_NAME=x500_drop. The payload sits
  exactly at the mount (body origin 0.24 m above ground - 0.14 m) so DetachableJoint welds it there.
-->
<sdf version="1.9">
  <world name="drop_world">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <light name="sun" type="directional"><pose>0 0 500 0 0 0</pose><direction>0.001 0.625 -0.78</direction><diffuse>0.9 0.9 0.9 1</diffuse></light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <include><uri>model://x_marker</uri><name>x_marker</name><pose>@TX@ @TY@ 0 0 0 0</pose></include>
    <include><uri>model://x500_drop</uri><name>x500_drop</name><pose>@SX@ @SY@ 0.24 0 0 @SYAW@</pose></include>
    <include><uri>model://payload_drop</uri><name>payload_drop</name><pose>@SX@ @SY@ 0.10 0 0 @SYAW@</pose></include>
  </world>
</sdf>
