<?xml version="1.0" encoding="UTF-8"?>
<!--
  x_marker_world.sdf - Gazebo Harmonic world for X-marker drop mission
  =========================================================================
  Plugin migration from Classic (.world) to Harmonic (.sdf):

  Classic                             | Harmonic
  ------------------------------------|------------------------------------------
  libgazebo_ros_state.so              | removed (entity state via gz services)
  libgazebo_ros_link_attacher_plugin  | gazebo_ros_link_attacher (Harmonic port)
  libgazebo_ros_link_attacher.so      | merged into single attacher plugin
  <include model://sun>               | inline <light> (Harmonic has no sun model)
  <include model://ground_plane>      | inline ground_plane model
  ODE <solver> block                  | <physics type="ode"> simplified block
  GAZEBO_MODEL_PATH                   | GZ_SIM_RESOURCE_PATH

  Notes:
  - Sensors system (ogre2) handles camera rendering for x500_bombard.
  - Magnetometer system handles magnetometer sensors.
  - NavSat system handles GPS sensors.
  - ros_gz_bridge (ros-humble-ros-gzharmonic-bridge) is required for ROS2 ↔ gz bridge.
  - x500_bombard and payload_cylinder are spawned by PX4 SITL or manually.
-->
<sdf version="1.9">
  <world name="x_marker_world">

    <!-- ============================================================
         Physics: same parameters as Classic world (ODE, 250 Hz)
    ============================================================ -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- ============================================================
         World-level system plugins
         (replaces all libgazebo_ros_*.so and sensor plugins)
    ============================================================ -->
    <plugin name="gz::sim::systems::Physics"
            filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands"
            filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster"
            filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact"
            filename="gz-sim-contact-system"/>

    <!-- Sensor systems: handle IMU, baro, GPS, magnetometer, camera -->
    <plugin name="gz::sim::systems::Imu"
            filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure"
            filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::NavSat"
            filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer"
            filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::Sensors"
            filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Note: gz::sim::systems::DetachableJoint is a model-level plugin.
         It is defined inside x500_bombard/model.sdf on the drone model,
         not here at the world level. -->

    <!-- ============================================================
         GUI configuration (updated from Classic orbit camera)
    ============================================================ -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.4 0.4 0.4</ambient_light>
        <background_color>0.7 0.7 0.7</background_color>
        <!-- Camera posed to view the x_marker at (11, 10) and drone spawn at origin -->
        <camera_pose>15 6 5 0 0.7 2.35</camera_pose>
        <camera_clip>
          <near>0.25</near>
          <far>25000</far>
        </camera_clip>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin name="World control" filename="WorldControl">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">72</property>
          <property type="double" key="width">121</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name="World stats" filename="WorldStats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">0</property>
          <property type="bool" key="resizable">0</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name="Entity tree" filename="EntityTree"/>
    </gui>

    <!-- ============================================================
         Environment
    ============================================================ -->
    <gravity>0 0 -9.8066</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- GPS origin: same as PX4 default (Zurich) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Scene settings -->
    <scene>
      <grid>true</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ============================================================
         Sun light (replaces <include model://sun>)
    ============================================================ -->
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <!-- ============================================================
         Ground plane (replaces <include model://ground_plane>)
    ============================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============================================================
         X-marker ground target
         Positioned at (11, 10, 0): the drop mission target coordinates.
         Drone spawns at origin (0, 0); path_generation navigates to this
         position and triggers payload drop.
         Note: x_marker model uses Harmonic PBR material (see
               gazebo_models/x_marker/model.sdf)
    ============================================================ -->
    <include>
      <uri>model://x_marker</uri>
      <name>x_marker</name>
      <pose>11 10 0 0 0 0</pose>
    </include>

    <!-- ============================================================
         Payload cylinder
         Spawned as a separate model; attached to x500_bombard's
         payload_mount link via DetachableJoint plugin in model.sdf.

         Spawn z = 0.17 m:
           drone base_link world-z ≈ 0.24 (x500_base model pose)
           payload_mount offset from base_link = -0.07
           → belly world-z = 0.24 - 0.07 = 0.17

         Position reporting:
           Harmonic: gz::sim::systems::OdometryPublisher in payload.sdf
                     + ros_gz_bridge: /model/payload_cylinder/odometry
                       -> ROS2 /drone/payload/position (nav_msgs/Odometry)
    ============================================================ -->
    <include>
      <uri>model://payload_cylinder</uri>
      <name>payload_cylinder</name>
      <pose>0 0 0.17 0 0 0</pose>
    </include>

    <!-- ============================================================
         World origin coordinate axes (RGB = XYZ convention)
         X-axis: red   1 m pointing east (+X)
         Y-axis: green 1 m pointing north (+Y)
         Z-axis: blue  1 m pointing up (+Z)
         Axes are thin boxes (4 cm × 4 cm cross-section).
    ============================================================ -->
    <model name="world_origin_axes">
      <static>true</static>
      <link name="x_axis">
        <pose>0.5 0 0.02 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>1.0 0.04 0.04</size></box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>0.3 0.0 0.0 1</specular>
          </material>
        </visual>
      </link>
      <link name="y_axis">
        <pose>0 0.5 0.02 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.04 1.0 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
            <specular>0.0 0.3 0.0 1</specular>
          </material>
        </visual>
      </link>
      <link name="z_axis">
        <pose>0 0 0.52 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box><size>0.04 0.04 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.0 1.0 1</ambient>
            <diffuse>0.0 0.0 1.0 1</diffuse>
            <specular>0.0 0.0 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
