<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="payload_cylinder">
    
    <link name="payload_link">
      <self_collide>true</self_collide> 
      <inertial>
        <mass>0.1</mass> 
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="payload_visual">
        <geometry>
           <cylinder><radius>0.03</radius><length>0.005</length></cylinder>
        </geometry>
        <material>
          <ambient>0.8 0.0 0.0 1</ambient>
          <diffuse>0.8 0.0 0.0 1</diffuse>
        </material>
      </visual>
      
      <collision name="payload_collision">
        <geometry>
           <cylinder><radius>0.029</radius><length>0.005</length></cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.0</max_vel>
              <min_depth>0.002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <!-- Harmonic: OdometryPublisher replaces libgazebo_ros_p3d.so
         Publishes on gz-transport: /model/payload_cylinder/odometry
         Bridged to ROS2 nav_msgs/Odometry via ros_gz_bridge config:
           gz_topic:  /model/payload_cylinder/odometry
           ros_topic: /drone/payload/position
    -->
    <plugin name="gz::sim::systems::OdometryPublisher"
            filename="gz-sim-odometry-publisher-system">
      <odom_frame>world</odom_frame>
      <robot_base_frame>payload_cylinder</robot_base_frame>
      <odom_publish_frequency>10</odom_publish_frequency>
    </plugin>
  </model>
</sdf>