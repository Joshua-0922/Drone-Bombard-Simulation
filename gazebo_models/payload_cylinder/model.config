<?xml version="1.0"?>
<model>
  <name>payload_cylinder</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Drone Bombard Team</name>
    <email>team@dronebombard.com</email>
  </author>
  <description>
    Detachable payload cylinder for bomb-drop simulation.
    Position published on gz-transport (/model/payload_cylinder/odometry)
    and bridged to ROS2 /drone/payload/position via ros_gz_bridge.
    Attach/detach managed by gazebo_ros_link_attacher (Harmonic port).
  </description>
</model>
