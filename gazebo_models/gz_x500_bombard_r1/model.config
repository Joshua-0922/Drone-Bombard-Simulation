<?xml version="1.0"?>
<model>
  <name>gz_x500_bombard_r1</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Drone Bombard Team</name>
    <email>team@dronebombard.com</email>
  </author>
  <description>
    Drone rank 1 for Method A 1-World-4-Payload RL training.
    Based on x500_bombard with DetachableJoint targeting payload_1.
    PX4 connects via PX4_GZ_MODEL_NAME=x500_1.
    Drop triggered via /x500_1/drop gz topic.
  </description>
</model>
