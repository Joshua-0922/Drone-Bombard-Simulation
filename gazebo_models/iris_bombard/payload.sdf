<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="payload_cylinder">
    <pose>0 0 0.05 0 0 0</pose> 
    
    <link name="payload_link">
      <self_collide>true</self_collide> 
      <inertial>
        <mass>0.1</mass> 
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      
      <visual name="payload_visual">
        <geometry>
           <cylinder><radius>0.03</radius><length>0.005</length></cylinder>
        </geometry>
        <material>
          <script><name>Gazebo/Red</name><uri>file://media/materials/scripts/gazebo.material</uri></script>
        </material>
      </visual>
      
      <collision name="payload_collision">
        <geometry>
           <cylinder><radius>0.029</radius><length>0.005</length></cylinder>
        </geometry>
        <surface>
          <contact>
            <ode>
              <kp>100000.0</kp>
              <kd>100.0</kd>
              <max_vel>0.0</max_vel>
              <min_depth>0.002</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
    </link>

    <plugin name="payload_ground_truth" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/drone</namespace>
        <remapping>odom:=payload/position</remapping>
      </ros>
      <body_name>payload_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>10.0</update_rate> 
    </plugin>
  </model>
</sdf>